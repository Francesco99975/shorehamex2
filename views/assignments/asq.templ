package assignments

import (
	"strconv"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
)

templ Asq(site config.Site, questions []string, multi []string, path string) {
	@TestShell(site, TestShellProps{
		Eyebrow:       "Questionnaire",
		Title:         "Anxiety Symptoms Questionnaire",
		Subtitle:      "Please answer all questions honestly to help us provide better care.",
		QuestionCount: len(questions),
	}) {
		@Instructions("Read each statement and choose Yes or No. At the end there is an optional list where you can select everything that applies to you.")
		<form
			id="fq"
			data-test-form
			class="flex flex-col gap-4"
			hx-post={ path }
			hx-target="body"
			hx-replace-url="true"
			hx-indicator="#indicator"
		>
			@components.CSRF(site.CSRF)
			<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
			@TestProgress(TestProgressProps{Total: len(questions)})
			for index, question := range questions {
				@QuestionCard(QuestionCardProps{Number: index + 1, Prompt: question}) {
					@BinaryChoices(BinaryChoicesProps{Name: "A" + strconv.Itoa(index), Options: YesNoOptions, Required: true})
				}
			}
			@ChecklistSection("Do you experience or fear any of the following?", "Select all that apply. This part is optional.") {
				for index, item := range multi {
					@CheckTile("MA"+strconv.Itoa(index), item)
				}
			}
			@SubmitSection("Check that every question has an answer before you submit.") {
				<span>Submit questionnaire</span>
				@SubmitArrowIcon()
			}
		</form>
	}
}
