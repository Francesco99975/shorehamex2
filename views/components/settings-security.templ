package components

import (
	"github.com/Francesco99975/shorehamex2/views/icons"
	"github.com/Francesco99975/shorehamex2/views/ui"
)

type SecurityProps struct {
	TwoFAEnabled bool
	Sessions     []SessionInfo
	CSRF         string
}

type SessionInfo struct {
	Device    string
	Browser   string
	OS        string
	LastUsed  string
	Expires   string
	IsCurrent bool
	SessionID string
}

templ SettingsSecurityTab(props SecurityProps) {
	<div class="space-y-4">
		@ChangePasswordCard(props.CSRF)
		@TwoFactorCard(props.TwoFAEnabled, props.CSRF)
		@ActiveSessionsCard(props.Sessions, props.CSRF)
	</div>
}

templ ChangePasswordCard(csrf string) {
	<div class="rounded-xl border border-primary/10 bg-std shadow-sm">
		<div class="border-b border-primary/10 px-4 sm:px-6 py-4">
			<h2 class="text-base sm:text-lg font-semibold text-primary">Change Password</h2>
			<p class="text-sm text-primary/60">Update your password</p>
		</div>
		@ChangePasswordForm(csrf)
	</div>
}

templ ChangePasswordForm(csrf string) {
	<form
		hx-patch="/settings/password"
		hx-target="#success-message"
		hx-swap="outerHTML"
		{ ui.WithLoading("password-indicator")... }
		class="p-4 sm:p-6 space-y-4"
	>
		@CSRF(csrf)
		@ui.SecurePasswordInput(ui.PasswordProps{
			Name:         "current_password",
			Label:        "Current Password",
			Required:     true,
			ShowStrength: true,
		})
		@ui.SecurePasswordInput(ui.PasswordProps{
			Name:         "new_password",
			Label:        "New Password",
			Required:     true,
			ShowStrength: true,
			MinLen:       8})
		@ui.SecurePasswordInput(ui.PasswordProps{
			Name:         "confirm_password",
			Label:        "Confirm Password",
			Required:     true,
			ShowStrength: true,
			MinLen:       8,
		})
		<div id="password-response"></div>
		<div class="flex justify-end pt-4 border-t border-primary/10">
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonMD,
				Type:    ui.TypeSubmit,
				Loading: ui.LoadingConfig{
					IndicatorID: "password-indicator",
				},
			}) {
				<span>Change Password</span>
			}
		</div>
		<div id="success-message"></div>
	</form>
}

templ TwoFactorCard(enabled bool, csrf string) {
	if enabled {
		@TwoFAEnabledCard(csrf)
	} else {
		@TwoFADisabledCard(csrf)
	}
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

templ ActiveSessionsCard(sessions []SessionInfo, csrf string) {
	<section class="neon-border clip-panel overflow-hidden" aria-labelledby="sessions-heading">
		<header class="px-4 sm:px-6 py-4 border-b border-border bg-panel">
			<div class="font-mono text-[10px] text-accent/70 uppercase tracking-widest">\\ security</div>
			<h2 id="sessions-heading" class="glitch neon-primary text-base sm:text-lg font-bold tracking-widest" data-text="ACTIVE SESSIONS">ACTIVE SESSIONS</h2>
			<p class="mt-0.5 font-mono text-xs text-muted">manage devices currently signed in to your account</p>
		</header>
		<div class="divide-y divide-border" id="sessions-list">
			if len(sessions) == 0 {
				<p class="px-4 sm:px-6 py-8 text-center font-mono text-xs text-muted">no active sessions</p>
			} else {
				for _, session := range sessions {
					@SessionItem(session, csrf)
				}
			}
		</div>
	</section>
}

// SessionItem renders one session row.
//
// Layout (mobile-first):
//   • Top line: device icon + device/browser/OS identity + status/revoke action.
//   • Meta line: last-used and expiry, wrapping to two rows on narrow screens.
// The current session shows an "Active" badge instead of a revoke control so it
// can't be killed out from under the user.
templ SessionItem(session SessionInfo, csrf string) {
	<div
		id={ "session-" + session.SessionID }
		class={ "p-4 sm:px-6 transition-colors hover:bg-primary/5", templ.KV("bg-accent/5", session.IsCurrent) }
	>
		<div class="flex items-start justify-between gap-3">
			<div class="flex items-start gap-3 min-w-0 flex-1">
				<!-- Device icon in a clipped cyber tile -->
				<div class="shrink-0 h-10 w-10 clip-tag bg-panel border border-accent/40 flex items-center justify-center text-accent">
					if session.Device == "desktop" {
						@icons.Desktop("w-5 h-5")
					} else if session.Device == "tablet" {
						@icons.Tablet("w-5 h-5")
					} else {
						@icons.Smartphone("w-5 h-5")
					}
				</div>
				<div class="min-w-0">
					<!-- Identity: browser on OS, with device as fallback emphasis -->
					<p class="text-sm font-medium text-primary truncate">
						{ session.Browser } <span class="text-muted">on</span> { session.OS }
					</p>
					<p class="font-mono text-[11px] text-accent/70 uppercase tracking-widest capitalize truncate">{ session.Device }</p>
				</div>
			</div>
			<!-- Right rail: badge for current, revoke button otherwise -->
			<div class="shrink-0">
				if session.IsCurrent {
					@ui.Badge(ui.BadgeSuccess, false) {
						THIS DEVICE
					}
				} else {
					<form
						hx-delete={ "/settings/security/session/" + session.SessionID }
						hx-target={ "#session-" + session.SessionID }
						hx-swap="outerHTML swap:200ms"
						hx-confirm="Revoke this session? The device will be signed out immediately."
					>
						@CSRF(csrf)
						@ui.Button(ui.ButtonProps{Variant: ui.ButtonDanger, Size: ui.ButtonSM, Type: ui.TypeSubmit}) {
							REVOKE
						}
					</form>
				}
			</div>
		</div>
		<!-- Meta line: last used + expiry. Wraps cleanly on mobile. -->
		<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] text-muted">
			<span class="inline-flex items-center gap-1">
				<span class="text-accent/70 uppercase tracking-widest">last used</span>
				{ session.LastUsed }
			</span>
			<span class="inline-flex items-center gap-1">
				<span class="text-accent/70 uppercase tracking-widest">expires</span>
				{ session.Expires }
			</span>
		</div>
	</div>
}
