package assignments

import (
	"strconv"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
)

templ P3(site config.Site, groups [][]string, path string) {
	@TestShell(site, TestShellProps{
		Eyebrow:       "Assessment",
		Title:         "P3 Test",
		QuestionCount: len(groups),
	}) {
		@Instructions("For each question, choose the answer that fits you best.")
		<form
			id="fq"
			data-test-form
			class="flex flex-col gap-4"
			hx-post={ path }
			hx-target="body"
			hx-replace-url="true"
			hx-indicator="#indicator"
		>
			@components.CSRF(site.CSRF)
			<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
			@TestProgress(TestProgressProps{Total: len(groups)})
			for index, group := range groups {
				@QuestionCard(QuestionCardProps{Number: index + 1, Prompt: "Choose the most appropriate answer"}) {
					@StatementChoices(StatementChoicesProps{Name: "A" + strconv.Itoa(index), Options: OptionsFromLabels(group, 1), Required: true})
				}
			}
			@SubmitSection("Check that every question has an answer before you submit.") {
				@SubmitCheckIcon()
				<span>Submit</span>
			}
		</form>
	}
}
