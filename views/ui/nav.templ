package ui

import (
	"github.com/Francesco99975/shorehamex2/views/icons"
	"strings"
)

// NavLink is one entry in the navigation. Active state is computed client-side
// from the inherited `path` reactive value owned by HeaderCore.
type NavLink struct {
	Label string
	Href  string
	CTA   bool
	Icon  templ.Component
}

var DefaultNavLinks = []NavLink{
	{Label: "Home", Href: "/auth", Icon: icons.Lense("w-5 h-5")},
	{Label: "Theme", Href: "/theme", Icon: icons.Camera("w-5 h-5")},
	{Label: "About", Href: "/about", Icon: icons.Info("w-5 h-5")},
}

var AdminNavLinks = []NavLink{
	{Label: "Dashboard", Href: "/dashboard", Icon: icons.Desktop("w-5 h-5")},
	{Label: "Patients", Href: "/patients", Icon: icons.UsersIcon("w-5 h-5")},
	{Label: "Assignments", Href: "/assignments", Icon: icons.CheckIcon("w-5 h-5")},
	{Label: "Test Catalog", Href: "/tests", Icon: icons.Database("w-5 h-5")},
	{Label: "Profile", Href: "/settings/profile", Icon: icons.Home("w-5 h-5")},
	{Label: "Security", Href: "/settings/security", Icon: icons.Lock("w-5 h-5")},
	{Label: "Account", Href: "/settings/account", Icon: icons.Info("w-5 h-5")},
	{Label: "Users", Href: "/settings/users", Icon: icons.UsersIcon("w-5 h-5")},
}

// activeExpr returns an Alpine boolean expression true when the inherited
// `path` matches `href` exactly or as a sub-route. Identical logic to the
// cyberpunk version — behaviour is unchanged.
func activeExpr(href string) string {
	if href == "" || strings.HasPrefix(href, "#") {
		return "false"
	}
	if href == "/" {
		return "path === '/'"
	}
	h := strings.TrimRight(href, "/")
	return "(path === '" + h + "' || path.startsWith('" + h + "/'))"
}

// HeaderBrand renders the logo glyph + app name / title block. General skin:
// rounded glyph tile with a soft shadow, sentence-case title (no mono/glow).
templ HeaderBrand(appName, title, homeHref string) {
	<a
		href={ templ.SafeURL(nonEmpty(homeHref, "/")) }
		class="flex items-center gap-3 group min-w-0"
		aria-label={ nonEmpty(title, appName) }
	>
		@icons.Lense("text-primary w-5 h-5")
		<span class="text-xl font-semibold tracking-tight">{ appName }</span>
	</a>
}

templ HeaderBrandFg(appName, title, homeHref string) {
	<a
		href={ templ.SafeURL(nonEmpty(homeHref, "/")) }
		class="flex items-center gap-3 group min-w-0"
		aria-label={ nonEmpty(title, appName) }
	>
		@icons.Lense("text-primary-fg  w-5 h-5")
		<span class="text-xl font-semibold tracking-tight">{ appName }</span>
	</a>
}

templ DrawerNav(links ...NavLink) {
	{{list := links
if len(list) == 0 {
	list = DefaultNavLinks
}
	}}
	<nav class="flex-1 p-3 space-y-1 overflow-y-auto" aria-label="Primary" x-data="{path: window.location.pathname}" hx-boost="true">
		for _, l := range list {
			{{ active := activeExpr(l.Href) }}
			if l.CTA {
				<a
					href={ templ.SafeURL(l.Href) }
					:aria-current={ active + " ? 'page' : null" }
					class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-semibold shadow-sm hover:bg-primary/90 transition-colors"
				>
					<span>
						@l.Icon
					</span>
					<span>{ l.Label }</span>
				</a>
			} else {
				<a
					href={ templ.SafeURL(l.Href) }
					:aria-current={ active + " ? 'page' : null" }
					class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition"
					:class={ active + " ? 'bg-primary text-primary-fg font-semibold' : 'text-muted hover:bg-std hover:text-fg'" }
				>
					<span>
						@l.Icon
					</span>
					<span>{ l.Label }</span>
				</a>
			}
		}
	</nav>
}

// HeaderNav is the desktop primary nav (hidden under md). Reads inherited
// `path` for active highlighting; CTA links render as the filled button.
templ HeaderNav(links ...NavLink) {
	{{list := links
if len(list) == 0 {
	list = DefaultNavLinks
}
	}}
	<nav
		class="hidden md:flex items-center gap-1 lg:gap-2"
		aria-label="Primary"
	>
		for _, l := range list {
			{{ active := activeExpr(l.Href) }}
			if l.CTA {
				<a
					href={ templ.SafeURL(l.Href) }
					:aria-current={ active + " ? 'page' : null" }
					class="px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-semibold shadow-sm hover:bg-primary/90 transition-colors"
				>{ l.Label }</a>
			} else {
				<a
					href={ templ.SafeURL(l.Href) }
					:aria-current={ active + " ? 'page' : null" }
					class="px-3 py-2 rounded-lg text-sm font-medium transition-colors"
					:class={ active + " ? 'bg-primary/10 text-primary font-semibold' : 'text-muted hover:text-foreground hover:bg-muted/40'" }
				>{ l.Label }</a>
			}
		}
	</nav>
}

// HeaderActions is a right-side cluster wrapper / slot.
templ HeaderActions() {
	<div class="flex items-center gap-1 sm:gap-2">
		{ children... }
	</div>
}

// HeaderBurger toggles the inherited `mobileMenuOpen`. Hidden at md+.
templ HeaderBurger() {
	<button
		type="button"
		@click="mobileMenuOpen = !mobileMenuOpen"
		class="md:hidden w-9 h-9 rounded-lg border border-border text-foreground grid place-items-center hover:bg-muted/40 transition-colors"
		:aria-expanded="mobileMenuOpen.toString()"
		aria-controls="mobile-menu"
		aria-label="Toggle menu"
	>
		<svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
		</svg>
		<svg x-show="mobileMenuOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
		</svg>
	</button>
}

// HeaderMobilePanel is the slide-down mobile menu (md:hidden), bound to the
// inherited `mobileMenuOpen`. General skin: soft rounded rows, left accent
// bar on the active item.
templ HeaderMobilePanel(links ...NavLink) {
	{{list := links
if len(list) == 0 {
	list = DefaultNavLinks
}
	}}
	<div
		id="mobile-menu"
		x-show="mobileMenuOpen"
		x-cloak
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click.self="mobileMenuOpen = false"
		class="fixed inset-0 top-16 lg:top-20 bg-foreground/30 backdrop-blur-sm md:hidden z-40"
	>
		<nav
			x-show="mobileMenuOpen"
			x-transition:enter="transition ease-out duration-300 delay-100"
			x-transition:enter-start="opacity-0 -translate-y-4"
			x-transition:enter-end="opacity-100 translate-y-0"
			class="flex flex-col gap-1 py-4 px-3 bg-surface/98 backdrop-blur-md border-b border-border shadow-xl"
			aria-label="Mobile"
		>
			for _, l := range list {
				{{ active := activeExpr(l.Href) }}
				if l.CTA {
					<a
						href={ templ.SafeURL(l.Href) }
						@click="mobileMenuOpen = false"
						:aria-current={ active + " ? 'page' : null" }
						class="mt-2 self-start px-6 py-2.5 rounded-lg bg-primary text-primary-foreground text-sm font-semibold shadow-sm"
					>{ l.Label }</a>
				} else {
					<a
						href={ templ.SafeURL(l.Href) }
						@click="mobileMenuOpen = false"
						:aria-current={ active + " ? 'page' : null" }
						class="block px-3 py-3 rounded-lg text-sm font-medium border-l-2 transition-colors"
						:class={ active + " ? 'text-primary bg-primary/10 border-primary' : 'text-foreground/85 hover:text-primary hover:bg-muted/40 border-transparent'" }
					>{ l.Label }</a>
				}
			}
			{ children... }
		</nav>
	</div>
}

// HeaderMobileLogout drops into the @HeaderMobilePanel children slot.
templ HeaderMobileLogout(endpoint string) {
	<div class="mt-2 pt-2 border-t border-border">
		<button
			type="button"
			hx-post={ endpoint }
			hx-confirm="Log out of your account?"
			@click="mobileMenuOpen = false"
			class="w-full inline-flex items-center gap-2 px-3 py-3 rounded-lg text-sm font-medium text-error hover:bg-error/10 transition-colors text-left"
		>
			@icons.LogOut("w-4 h-4")
			<span>Logout</span>
		</button>
	</div>
}

// ── Breadcrumbs / Pagination / Tabs ───────────────────────────────────────

// Crumb is one breadcrumb segment. Last renders as current.
type Crumb struct {
	Label string
	Href  string
}

templ Breadcrumbs(crumbs ...Crumb) {
	<nav class="flex flex-wrap items-center gap-1.5 text-sm" aria-label="Breadcrumb">
		for i, c := range crumbs {
			if i > 0 {
				<span class="text-muted" aria-hidden="true">/</span>
			}
			if i == len(crumbs)-1 {
				<span class="text-foreground font-medium" aria-current="page">{ c.Label }</span>
			} else {
				<a href={ templ.SafeURL(c.Href) } class="text-muted hover:text-primary transition-colors">{ c.Label }</a>
			}
		}
	</nav>
}

// PaginationProps — server-paged navigator wired to HTMX. Identical field set
// and behaviour to the cyberpunk version; only the button skin changes.
type PaginationProps struct {
	Current    int
	TotalRows  int
	TotalPages int
	URL        string
	Target     string
	Param      string
	Swap       string
	Include    string
	PushURL    bool
	Window     int
	Attrs      templ.Attributes
}

// Pagination is a compact, HTMX-driven server pager with sliding window and
// ellipses. Mobile shows prev / "page X of Y" / next; >=sm shows the numbered
// window. Same responsive strategy as the original.
templ Pagination(p PaginationProps) {
	if p.TotalPages > 1 {
		{{ pages := paginationPages(p.Current, p.TotalPages, p.Window) }}
		<nav class="text-sm" aria-label="Pagination" role="navigation">
			<div class="flex sm:hidden items-center justify-between gap-2 w-full">
				@paginationBtn(p, p.Current-1, p.Current <= 1, "‹ Prev", "Previous page", "px-3 py-1.5 flex-none")
				<span class="flex-1 text-center text-muted truncate" aria-live="polite">
					page <span class="text-foreground font-medium">{ itoa(p.Current) }</span> of { itoa(p.TotalPages) }
				</span>
				@paginationBtn(p, p.Current+1, p.Current >= p.TotalPages, "Next ›", "Next page", "px-3 py-1.5 flex-none")
			</div>
			<div class="hidden sm:flex items-center gap-1 flex-wrap">
				@paginationBtn(p, p.Current-1, p.Current <= 1, "‹", "Previous page", "px-2.5 py-1.5")
				for _, n := range pages {
					if n == 0 {
						<span class="px-1.5 text-muted select-none" aria-hidden="true">…</span>
					} else if n == p.Current {
						<span
							aria-current="page"
							class="min-w-8 h-8 px-2 rounded-lg bg-primary text-primary-foreground font-medium flex items-center justify-center"
						>{ itoa(n) }</span>
					} else {
						@paginationBtn(p, n, false, itoa(n), "Go to page "+itoa(n), "min-w-8 h-8 px-2 flex items-center justify-center")
					}
				}
				@paginationBtn(p, p.Current+1, p.Current >= p.TotalPages, "›", "Next page", "px-2.5 py-1.5")
			</div>
		</nav>
	}
}

// paginationBtn renders one navigation button. Disabled renders as a
// non-interactive span. When neither Swap nor Target is set it falls back to a
// real <a href> navigation (progressive enhancement), matching the behaviour
// we added to the cyberpunk version.
templ paginationBtn(p PaginationProps, target int, disabled bool, label, aria, sizing string) {
	{{param := p.Param
if param == "" {
	param = "page"
}
	}}
	{{swap := p.Swap
if swap == "" {
	swap = "innerHTML"
}
	}}
	{{ asLink := p.Swap == "" && p.Target == "" }}
	{{sep := "?"
if strings.Contains(p.URL, "?") {
	sep = "&"
}
	}}
	if disabled {
		<span
			class={ "rounded-lg border border-border text-muted opacity-40 cursor-not-allowed flex items-center justify-center", sizing }
			aria-disabled="true"
			aria-label={ aria }
		>{ label }</span>
	} else if asLink {
		<a
			href={ templ.SafeURL(p.URL + sep + param + "=" + itoa(target)) }
			class={ "rounded-lg border border-border text-foreground hover:bg-muted/40 hover:border-primary/40 transition-colors", sizing }
			aria-label={ aria }
			if p.Include != "" {
				x-on:click={ "const u = new URL($el.href, location.origin); " +
					"document.querySelectorAll('" + p.Include + "').forEach(el => { if(el.name) u.searchParams.set(el.name, el.value); }); " +
					"$el.href = u.pathname + u.search;" }
			}
			{ p.Attrs... }
		>{ label }</a>
	} else {
		<button
			type="button"
			class={ "rounded-lg border border-border text-foreground hover:bg-muted/40 hover:border-primary/40 transition-colors", sizing }
			aria-label={ aria }
			hx-get={ p.URL }
			hx-target={ "#" + p.Target }
			hx-swap={ swap }
			hx-vals={ `{"` + param + `": ` + itoa(target) + `}` }
			if p.Include != "" {
				hx-include={ p.Include }
			}
			if p.PushURL {
				hx-push-url
			}
			{ p.Attrs... }
		>{ label }</button>
	}
}

// TabItem = one tab.
type TabItem struct {
	ID    string
	Label string
}

templ Tabs(initialID string, items ...TabItem) {
	<div x-data={ "{ tab: '" + initialID + "' }" }>
		<div role="tablist" class="flex gap-1 border-b border-border overflow-x-auto">
			for _, it := range items {
				<button
					role="tab"
					:aria-selected={ "tab === '" + it.ID + "'" }
					@click={ "tab = '" + it.ID + "'" }
					:class={ "tab === '" + it.ID + "' ? 'text-primary border-primary' : 'text-muted border-transparent hover:text-foreground'" }
					class="px-4 py-2 -mb-px border-b-2 text-sm font-medium whitespace-nowrap transition-colors"
				>
					{ it.Label }
				</button>
			}
		</div>
		<div class="pt-4">
			{ children... }
		</div>
	</div>
}

templ TabPanel(id string) {
	<div x-show={ "tab === '" + id + "'" } role="tabpanel">
		{ children... }
	</div>
}
