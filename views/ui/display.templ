package ui

import "strconv"

templ DataListGroup() {
	<div class="p-4 sm:p-6">
		<dl class="grid grid-cols-2 gap-3 sm:gap-4">
			{ children... }
		</dl>
	</div>
}

// StatCardProps — dashboard metric tile.
// DeltaClass is a Tailwind text-* class for the delta line (e.g. "text-success").
type StatCardProps struct {
	Label      string
	Value      string
	Delta      string
	DeltaClass string
}

templ StatCard(p StatCardProps) {
	<div class="card p-4 transition-shadow hover:shadow-md">
		<dt class="text-xs text-muted font-medium uppercase tracking-wide">{ p.Label }</dt>
		<dd class="text-2xl font-bold text-foreground mt-1">{ p.Value }</dd>
		if p.Delta != "" {
			<div class={ "text-xs font-medium mt-1", nonEmpty(p.DeltaClass, "text-muted") }>{ p.Delta }</div>
		}
	</div>
}

// Card is a generic container with a soft border, rounded corners and a subtle
// shadow. Use Title/Eyebrow for a standard header, or pass children only for a
// blank canvas. Padded defaults to true; set it false for edge-to-edge content
// like tables.
type CardProps struct {
	Eyebrow string // small caption above the title
	Title   string
	Padded  bool
}

templ Card(p CardProps) {
	<article class={ "card", templ.KV("p-5", p.Padded), templ.KV("p-0 overflow-hidden", !p.Padded) }>
		if p.Eyebrow != "" || p.Title != "" {
			<header class={ "mb-4", templ.KV("p-5 pb-0", !p.Padded) }>
				if p.Eyebrow != "" {
					<div class="text-xs text-muted font-medium uppercase tracking-wide">{ p.Eyebrow }</div>
				}
				if p.Title != "" {
					<h3 class="text-lg font-semibold text-foreground mt-0.5">{ p.Title }</h3>
				}
			</header>
		}
		{ children... }
	</article>
}

// Column definition for @DataTable.
type Column struct {
	Header string
	Key    string
	// Align: "" (default left), "right", "center"
	Align string
	// HideBelow: optional Tailwind breakpoint where this column disappears ("sm", "md", "lg").
	HideBelow string
}

func colAlign(a string) string {
	switch a {
	case "right":
		return "text-right"
	case "center":
		return "text-center"
	}
	return "text-left"
}

func colHide(b string) string {
	switch b {
	case "sm":
		return "hidden sm:table-cell"
	case "md":
		return "hidden md:table-cell"
	case "lg":
		return "hidden lg:table-cell"
	}
	return ""
}

// DataTable renders the <table> chrome with a column header row. Body rows are
// passed via children using @TableRow so apps do their own type-safe rendering.
templ DataTable(cols ...Column) {
	<div class="card p-0 overflow-auto">
		<table class="w-full text-sm">
			<thead>
				<tr class="border-b border-border bg-muted/30">
					for _, c := range cols {
						<th class={ "px-4 py-3 font-medium text-muted text-xs uppercase tracking-wide", colAlign(c.Align), colHide(c.HideBelow) }>
							{ c.Header }
						</th>
					}
				</tr>
			</thead>
			<tbody>
				{ children... }
			</tbody>
		</table>
	</div>
}

// TableRow wraps a <tr> with the hover style. Place <td>'s inside as children.
templ TableRow() {
	<tr class="border-b border-border last:border-0 transition-colors hover:bg-muted/40">
		{ children... }
	</tr>
}

// ActivityGridProps — GitHub-style heatmap.
type ActivityGridProps struct {
	Cols int // columns (weeks). Defaults to 14.
	Rows int // rows (days/hours). Defaults to 7.
	// Values: row-major intensity 0..1. If empty, a random matrix is used (demo mode).
	Values []float64
}

// ActivityGrid draws a Cols×Rows heatmap. Intensities shift from surface →
// border → accent → primary. Pass explicit Values for real data.
templ ActivityGrid(p ActivityGridProps) {
	{{
		cols := nonZero(p.Cols, 14)
		rows := nonZero(p.Rows, 7)
	}}
	<div>
		<div
			class="grid gap-1"
			style={ "grid-template-columns: repeat(" + strconv.Itoa(cols) + ", minmax(0,1fr));" }
			if len(p.Values) == 0 {
				x-data={ "{ cells: Array.from({length: " + strconv.Itoa(cols*rows) + "}, () => Math.random()) }" }
			} else {
				x-data={ "{ cells: " + floatsToJS(p.Values) + " }" }
			}
		>
			<template x-for="(c, i) in cells" :key="i">
				<div
					class="aspect-square rounded-[3px]"
					:style="`background: color-mix(in oklab, ${c > 0.75 ? 'var(--color-primary)' : c > 0.45 ? 'var(--color-accent)' : c > 0.2 ? 'var(--color-border)' : 'var(--color-muted)'} ${Math.max(12, Math.round(c*100))}%, var(--color-surface));`"
				></div>
			</template>
		</div>
		<div class="mt-2 flex items-center gap-1.5 text-xs text-muted">
			<span>less</span>
			<span class="w-3 h-3 rounded-[3px] bg-muted/40"></span>
			<span class="w-3 h-3 rounded-[3px] bg-accent/40"></span>
			<span class="w-3 h-3 rounded-[3px] bg-accent"></span>
			<span class="w-3 h-3 rounded-[3px] bg-primary"></span>
			<span>more</span>
		</div>
	</div>
}

// TimelineEvent — one entry on a vertical timeline.
// Kind drives the node colour: "primary" | "accent" | "success" | "warning" | "error" | "info".
type TimelineEvent struct {
	Time  string
	Title string
	Body  string
	Kind  string
}

templ Timeline(events ...TimelineEvent) {
	<ol class="relative border-l-2 border-border pl-6 space-y-5">
		for _, e := range events {
			<li class="relative">
				<span
					class="absolute -left-[31px] top-1 w-3 h-3 rounded-full ring-4 ring-surface"
					style={ "background: var(--color-" + nonEmpty(e.Kind, "primary") + ");" }
				></span>
				<div class="text-xs text-muted font-medium">{ e.Time }</div>
				<div class="font-semibold text-foreground">{ e.Title }</div>
				if e.Body != "" {
					<div class="text-sm text-muted mt-0.5">{ e.Body }</div>
				}
			</li>
		}
	</ol>
}

// AvatarProps — round initial-avatar.
// Colour drives both background and foreground contrast.
type AvatarProps struct {
	Initial string
	// Color: "primary" | "accent" | "success" | "warning" | "error" | "muted"
	Color string
	// Size: "sm" (w-8), "md" (w-10, default), "lg" (w-12)
	Size string
}

func avatarColor(c string) string {
	switch c {
	case "accent":
		return "bg-accent text-accent-foreground"
	case "success":
		return "bg-success text-background"
	case "warning":
		return "bg-warning text-background"
	case "error":
		return "bg-error text-background"
	case "muted":
		return "bg-muted text-foreground"
	}
	return "bg-primary text-primary-foreground"
}

func avatarSize(s string) string {
	switch s {
	case "sm":
		return "w-8 h-8 text-xs"
	case "lg":
		return "w-12 h-12 text-base"
	}
	return "w-10 h-10 text-sm"
}

templ Avatar(p AvatarProps) {
	<div class={ "rounded-full grid place-items-center font-bold flex-none", avatarColor(p.Color), avatarSize(p.Size) }>
		{ p.Initial }
	</div>
}

// AvatarGroup overlaps avatars horizontally and optionally appends a "+N" pill.
templ AvatarGroup(overflow int, avatars ...AvatarProps) {
	<div class="flex -space-x-2">
		for _, a := range avatars {
			<div class={ "rounded-full grid place-items-center font-bold ring-2 ring-surface flex-none", avatarColor(a.Color), avatarSize(nonEmpty(a.Size, "sm")) }>
				{ a.Initial }
			</div>
		}
		if overflow > 0 {
			<div class="w-8 h-8 rounded-full ring-2 ring-surface bg-muted text-foreground grid place-items-center text-xs font-semibold">+{ strconv.Itoa(overflow) }</div>
		}
	</div>
}

// EmptyStateProps — the "no content yet" placeholder.
type EmptyStateProps struct {
	Title       string
	Description string
	CTALabel    string
	CTAHref     string
}

templ EmptyState(p EmptyStateProps) {
	<div class="card p-8 text-center">
		<div class="mx-auto w-14 h-14 rounded-full bg-muted/50 text-muted grid place-items-center mb-4">
			<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3" y="4" width="18" height="16" rx="2"></rect>
				<path d="M3 10h18M8 4v16"></path>
			</svg>
		</div>
		<div class="text-lg font-semibold text-foreground">{ p.Title }</div>
		if p.Description != "" {
			<p class="text-sm text-muted mt-1 max-w-sm mx-auto text-pretty">{ p.Description }</p>
		}
		if p.CTALabel != "" && p.CTAHref != "" {
			<a
				href={ templ.SafeURL(p.CTAHref) }
				class="inline-flex items-center justify-center mt-5 rounded-lg bg-primary text-primary-foreground text-sm font-medium px-4 py-2 transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
			>
				{ p.CTALabel }
			</a>
		}
	</div>
}
