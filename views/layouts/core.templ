package layouts

import (
	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
	"github.com/Francesco99975/shorehamex2/views/ui"
)

templ CoreHTML(site config.Site) {
	<!DOCTYPE html>
	<html
		lang="en"
		x-data="{
				mobileMenuOpen: false,
				drawer: false,
				darkMode: localStorage.getItem('darkMode') === 'true' ? true :
						(localStorage.getItem('darkMode') === 'false' ? false :
						window.matchMedia('(prefers-color-scheme: dark)').matches)
  						}"
		x-init="
		if(darkMode) {
			document.documentElement.classList.add('dark');
		} else {
			document.documentElement.classList.remove('dark');
		}

		$watch('darkMode', val => {
			localStorage.setItem('darkMode', val);
			if(val) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		});

		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
			if (localStorage.getItem('darkMode') === null) {
				darkMode = e.matches;
			}
			});
		"
	>
		@components.SEO(site)
		<body
			class="bg-std antialiased min-h-screen transition-colors"
			x-data="{
				navOpen: false,
				toasts: [],
				pushToast(kind, msg) {
					const id = Date.now() + Math.random();
					this.toasts.push({id, kind, msg});
					setTimeout(()=>{ this.toasts = this.toasts.filter(t=>t.id!==id); }, 5000);
				}
			}"
			x-on:toast.window="pushToast($event.detail.kind, $event.detail.msg)"
		>
			{ children... }
		</body>
		for _, script := range site.PageScripts {
			@components.Script(script.JSFile, site.Nonce, script.JSIntegrity)
		}
		@ui.ToastStack()
	</html>
}
