package assignments

import (
	"strconv"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
)

var dassOptions = []ChoiceOption{
	{Label: "Did not apply to me at all", Value: "0"},
	{Label: "Mildly, but it didn't bother me much", Value: "1"},
	{Label: "Applied to me to a considerable degree, or a good part of the time", Value: "2"},
	{Label: "Applied to me very much, or most of the time", Value: "3"},
}

templ Dass42(site config.Site, questions []string, path string) {
	@TestShell(site, TestShellProps{
		Eyebrow:       "Assessment",
		Title:         "Depression Anxiety Stress Scales",
		Subtitle:      "Please complete all questions.",
		QuestionCount: len(questions),
	}) {
		@Instructions("Below is a list of common symptoms. Please carefully read each item in the list. Indicate how much you have been bothered by that symptom during the past month, including today.")
		<form
			data-test-form
			class="flex flex-col gap-4"
			hx-post={ path }
			hx-replace-url="true"
			hx-target="body"
			hx-indicator="#indicator"
		>
			@components.CSRF(site.CSRF)
			<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
			@TestProgress(TestProgressProps{Total: len(questions)})
			for i, question := range questions {
				@QuestionCard(QuestionCardProps{Number: i + 1, Prompt: question}) {
					@ScaleChoices(ScaleChoicesProps{Name: "q" + strconv.Itoa(i), Options: dassOptions, Required: true, Columns: 2})
				}
			}
			@SubmitSection("Check that every question has an answer before you submit.") {
				@SubmitCheckIcon()
				<span>Submit assessment</span>
			}
		</form>
	}
}
