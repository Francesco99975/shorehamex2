package assignments

import (
	"strconv"
	"time"

	"github.com/Francesco99975/shorehamex2/cmd/boot"
	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
)

const (
	mmpiTotalPages   = 23
	mmpiItemsPerPage = 25
)

templ MMPI(site config.Site, questions []string, page int, path string) {
	@TestShell(site, TestShellProps{
		Eyebrow:  "Assessment",
		Title:    "MMPI-2",
		Subtitle: "Read each statement and decide whether it is true or false as it applies to you. There are no right or wrong answers.",
	}) {
		<form
			id="fq"
			data-test-form
			class="flex flex-col gap-4"
			hx-post={ path }
			hx-indicator="#indicator"
		>
			@MMPIFormPartial(questions, page, site.CSRF, site.Nonce)
		</form>
	}
}

// MMPIFormPartial is swapped into #fq on every page submit, so it carries
// its own page stepper and progress bar.
templ MMPIFormPartial(questions []string, page int, csrf string, nonce string) {
	<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
	<input type="hidden" id="page" name="page" value={ strconv.Itoa(page) }/>
	@PageStepper(PageStepperProps{Page: page, TotalPages: mmpiTotalPages})
	@TestProgress(TestProgressProps{Total: len(questions), Label: "Statements answered on this page"})
	for index, question := range questions {
		@QuestionCard(QuestionCardProps{Number: index + 1 + ((page - 1) * mmpiItemsPerPage), Prompt: question}) {
			@BinaryChoices(BinaryChoicesProps{
				Name:     strconv.Itoa(page) + "A" + strconv.Itoa(index),
				Options:  TrueFalseOptions,
				Required: !(boot.Environment.GoEnv == "development"),
			})
		}
	}
	@components.CSRF(csrf)
	if page == mmpiTotalPages {
		@SubmitSection("This is the last page. Check your answers, then submit the test.") {
			@SubmitCheckIcon()
			<span>Submit test</span>
		}
	} else {
		@SubmitSection("Your answers on this page are saved when you continue.") {
			<span>Continue to page { strconv.Itoa(page + 1) } of { strconv.Itoa(mmpiTotalPages) }</span>
			@SubmitArrowIcon()
		}
	}
}
