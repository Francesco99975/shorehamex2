package views

import (
	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/internal/enums"
	"github.com/Francesco99975/shorehamex2/views/components"
	"github.com/Francesco99975/shorehamex2/views/layouts"
	"github.com/Francesco99975/shorehamex2/views/ui"
	"strconv"
)

type PatientsViewData struct {
	Items   []components.PatientItemProps
	Total   int
	Page    int
	PerPage int
	Query   string
	Href    func(page int) string
}

func (v PatientsViewData) totalPages() int {
	return max(1, (v.Total+v.PerPage-1)/v.PerPage)
}

templ Patients(site config.Site, vm PatientsViewData) {
	@layouts.AuthenticatedLayout(site) {
		<main class="flex-1 p-4 sm:p-6 max-w-[1400px] w-full mx-auto" x-data="{ newPatient: false }">
			<div class="space-y-4">
				<div class="px-4 sm:px-6 py-4 border-b border-primary/10 flex flex-col sm:flex-row gap-3">
					<div class="flex-1">
						@ui.Search(ui.SearchProps{
							Name:           "q",
							Value: 			vm.Query,
							GetURL:         "/patients",
							TargetID:       "patients-results",
							DebounceMS:     300,
							Placeholder:    "Search patients...",
							ExternalTarget: true,
						})
					</div>
					@ui.Button(ui.ButtonProps{
						Size:  ui.ButtonMD,
						Attrs: templ.Attributes{"@click": "newPatient = true"},
					}) {
						<span class="font-semibold">New Patient</span>
					}
					@ui.Modal(ui.ModalProps{
						Title:    "Add a new Patient",
						OpenExpr: "newPatient",
						Subtitle: "Register a new patient.",
						MaxW:     "320px",
					}) {
						<form
							hx-post="/patients"
							hx-swap="none"
							{ ui.WithLoading("new-patient-indicator")... }
							@htmx:after-request="if(event.detail.successful) newPatient = false"
							class="p-6 space-y-6"
						>
							@components.CSRF(site.CSRF)
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								@ui.Input(ui.InputProps{
									Name:     "fullname",
									Label:    "Full Name *",
									Required: true,
								})
								@ui.Input(ui.InputProps{
									Name:     "email",
									Type:     "email",
									Label:    "Email *",
									Required: true,
								})
								@ui.PhoneInput(ui.PhoneInputProps{
									Name:     "phone",
									Label:    "Phone *",
									Required: true,
								})
								@ui.DateOfBirth(ui.DateOfBirthProps{
									Name:     "dob",
									Label:    "Date of birth *",
									Hint:     "Day / Month / Year",
									MaxAge:   120,
									Required: true,
								})
								@ui.Droplist(ui.DroplistProps{
									Name: "sex", Label: "Sex *",
									Required: true,
									Selected: enums.Sexes.MALE.String(),
									Opts:     []ui.DropOption{{Value: enums.Sexes.MALE.String(), Label: enums.Sexes.MALE.String()}, {Value: enums.Sexes.FEMALE.String(), Label: enums.Sexes.FEMALE.String()}},
								})
							</div>
							<div class="flex gap-2 mt-6">
								@ui.Button(ui.ButtonProps{
									Variant: ui.ButtonGhost,
									Size:    ui.ButtonLG,
									Attrs:   templ.Attributes{"@click": "newPatient = false"},
									FullW:   true,
								}) {
									Cancel
								}
								@ui.Button(ui.ButtonProps{
									Variant: ui.ButtonPrimary,
									Type:    ui.TypeSubmit,
									Size:    ui.ButtonLG,
									Loading: ui.LoadingConfig{IndicatorID: "new-patient-indicator"},
									FullW:   true,
								}) {
									Add Patient
								}
							</div>
						</form>
					}
				</div>
				</div>
				<div id="patients-results">
					@PatientsResults(vm, site.CSRF)
				</div>
		</main>
	}
}

templ PatientsResults(vm PatientsViewData, csrf string) {
	<div
		hidden
		hx-get={ vm.Href(vm.Page) }
		hx-trigger="patients-changed from:body"
		hx-target="#patients-results"
		hx-swap="innerHTML"
	></div>
	<div id="patients-list" class="space-y-3">
		@PatientsList(vm.Items, csrf)
	</div>
	@components.EmptyState(len(vm.Items) == 0, false, "No patients found.")
	@PatientsPagination(vm)
}

templ PatientsList(patients []components.PatientItemProps, csrf string) {
	for _, patient := range patients {
		@components.PatientItem(patient, csrf)
	}
}

templ PatientsPagination(vm PatientsViewData) {
	<div
		id="patients-pagination"
		class="px-4 sm:px-6 py-4 border-t border-primary/10 flex flex-col sm:flex-row items-center justify-between gap-3"
	>
		if vm.Total > 0 {
			<p class="text-sm text-primary/60">
				Showing <span class="font-medium text-primary">{ strconv.Itoa((vm.Page-1)*vm.PerPage + 1) }-{ strconv.Itoa(min(vm.Page*vm.PerPage, vm.Total)) }</span> of <span class="font-medium text-primary">{ strconv.Itoa(vm.Total) }</span>
			</p>
			<div class="flex items-center gap-1">
				@ui.Pagination(ui.PaginationProps{
					Current:    vm.Page,
					TotalRows:  vm.Total,
					TotalPages: vm.totalPages(),
					Window:     vm.PerPage,
					Href:       vm.Href,
					Target:     "patients-results",
					Swap:       "innerHTML show:window:top",
				})
			</div>
		}
	</div>
}
