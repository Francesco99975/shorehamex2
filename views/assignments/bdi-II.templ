package assignments

import (
	"time"
	"strconv"

	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
	"github.com/Francesco99975/shorehamex2/views/layouts"
	"github.com/Francesco99975/shorehamex2/views/ui"
	"github.com/Francesco99975/shorehamex2/internal/models"
)

templ BDI2(site config.Site, topics []models.Topic, path string) {
	@layouts.Base(site) {
		<div class="flex items-center justify-center min-h-screen w-full px-4 py-8">
			<div class="w-full max-w-3xl">
				@ui.Card(ui.CardProps{}) {
					<h1 class="text-3xl font-bold text-foreground mb-2 text-center text-balance">Beck Depression Inventory-II</h1>
					<p class="text-muted text-center mb-8">Please complete all questions</p>
					<form
						hx-post={ path }
						hx-replace-url="true"
						hx-target="body"
						hx-indicator="#indicator"
						class="space-y-6"
					>
						@components.CSRF(site.CSRF)
						<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
						<div class="border-t border-border pt-6">
							<h2 class="text-lg font-semibold text-foreground mb-6 text-pretty">
								Below is a list of common symptoms. Please carefully read each item in the list. Indicate how much you have been bothered by that symptom during the past month, including today.
							</h2>
							<div class="space-y-6">
								for i, topic := range topics {
									{{ id := "q"+strconv.Itoa(i) }}
									<div class="bg-background rounded-xl p-6 border border-border hover:border-primary hover:shadow-md transition-all duration-200">
										<div class="flex items-start gap-3 mb-4 w-full">
											<span class="flex-shrink-0 w-8 h-8 bg-primary/10 text-primary rounded-full flex items-center justify-center text-sm font-semibold">
												{ strconv.Itoa(i + 1) }
											</span>
											<span class="text-foreground font-medium pt-1">{ topic.Name }</span>
										</div>
										<fieldset>
											for j, answer := range topic.Answers {
												@ui.RadioInput(id, id, answer, strconv.Itoa(j), true)
											}
										</fieldset>
									</div>
								}
							</div>
						</div>
						<div class="pt-6 border-t border-border">
							@ui.Button(ui.ButtonProps{
								Variant: ui.ButtonPrimary,
								Size:    ui.ButtonLG,
								Type:    ui.TypeSubmit,
								FullW:   true,
							}) {
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
								</svg>
								Submit Assessment
							}
						</div>
					</form>
				}
			</div>
		</div>
	}
}
