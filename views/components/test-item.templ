package components

import (
	"github.com/Francesco99975/shorehamex2/internal/models"
	"github.com/Francesco99975/shorehamex2/views/ui"
	"strings"
)

templ TestItem(test *models.TestDefinitionView) {
	{{ test.Code = strings.ReplaceAll(test.Code, "-", "") }}
	<div
		x-data={ "{" + test.Code + "modal: false}" }
		@click={ test.Code + "modal = true" }
		role="button"
		tabindex="0"
		@keydown.enter={ test.Code + "modal = true" }
		@keydown.space.prevent={ test.Code + "modal = true" }
		class="group bg-panel border border-border rounded-xl p-5 flex flex-col cursor-pointer transition hover:border-primary/50 hover:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
	>
		<div class="flex items-start justify-between">
			<div>
				<h2 class="text-lg font-semibold">{ test.Code }</h2>
				<p class="text-sm text-muted">{ test.Name }</p>
			</div>
			<span class="text-xs px-2 py-1 rounded-full bg-accent/15 text-accent font-medium">{ test.TestDomain }</span>
		</div>
		<p class="mt-3 text-sm text-muted leading-relaxed flex-1">{ test.ShortDescription }</p>
		<div class="mt-4 grid grid-cols-3 gap-2 text-center">
			<div class="p-2 rounded-lg bg-std"><p class="font-semibold text-sm">{ test.Items }</p><p class="text-xs text-muted">items</p></div>
			<div class="p-2 rounded-lg bg-std"><p class="font-semibold text-sm">~{ test.TypicalDurationMin } min</p><p class="text-xs text-muted">approx.</p></div>
			<div class="p-2 rounded-lg bg-std"><p class="font-semibold text-sm">{ test.AssignmentCount }</p><p class="text-xs text-muted">assigned</p></div>
		</div>
		<div class="mt-4 flex items-center gap-2">
			<button @click.stop={ test.Code + "modal = true" } class="flex-1 py-2 rounded-lg border border-border text-sm font-medium hover:bg-std">View details</button>
			<button class="flex-1 py-2 rounded-lg bg-primary text-primary-fg text-sm font-medium hover:opacity-90">Assign this test</button>
		</div>
		@ui.Modal(ui.ModalProps{
			Title:    test.Code,
			OpenExpr: test.Code + "modal",
			Subtitle: test.Name,
			MaxW:     "640px",
		}) {
			<div class="p-6 space-y-6">
				<!-- What it's for -->
				<div>
					<p class="text-sm font-medium mb-1">What it&apos;s for</p>
					<p class="text-sm text-muted leading-relaxed">{ test.Purpose }</p>
				</div>
				<!-- Quick facts -->
				<div class="grid grid-cols-3 gap-2 text-center">
					<div class="p-3 rounded-lg bg-std"><p class="font-semibold text-sm">{ test.Items }</p><p class="text-xs text-muted">items</p></div>
					<div class="p-3 rounded-lg bg-std"><p class="font-semibold text-sm">~{ test.TypicalDurationMin } min</p><p class="text-xs text-muted">approx.</p></div>
					<div class="p-3 rounded-lg bg-std"><p class="font-semibold text-sm">{ test.AssignmentCount }</p><p class="text-xs text-muted">assigned</p></div>
				</div>
				<!-- Population & scoring -->
				<div class="grid sm:grid-cols-2 gap-3">
					<div class="p-3 rounded-lg border border-border">
						<p class="text-xs uppercase tracking-wide text-muted mb-1">Intended population</p>
						<p class="text-sm">{ test.Population }</p>
					</div>
					<div class="p-3 rounded-lg border border-border">
						<p class="text-xs uppercase tracking-wide text-muted mb-1">Scoring</p>
						<p class="text-sm">{ test.ScoringDescription }</p>
					</div>
				</div>
				<!-- Parameters measured -->
				<div>
					<p class="text-sm font-medium mb-2">Parameters taken into account</p>
					<ul class="space-y-2">
						for _, param := range test.Parameters {
							<li class="flex gap-3 p-3 rounded-lg bg-std">
								<span class="w-1.5 h-1.5 mt-2 rounded-full bg-primary shrink-0"></span>
								<div>
									<p class="text-sm font-medium">{ param.Label }</p>
									<p class="text-xs text-muted">{ param.Note }</p>
								</div>
							</li>
						}
					</ul>
				</div>
			</div>
		}
	</div>
}
