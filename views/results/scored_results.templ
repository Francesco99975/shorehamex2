package results

import (
	"fmt"
	"sort"
	"strconv"
	"encoding/json"
	"bytes"
)

// AssignmentResult = assignment_results row + its assignment_sum_band_results.
type AssignmentResult struct {
	SumBands  []SumBand
	RawScores []RawScore // decoded from raw_scores jsonb (map -> ordered slice)
	Responses []Response // decoded from responses jsonb, in question order
}

func (r AssignmentResult) Empty() bool {
	return len(r.SumBands) == 0 && len(r.RawScores) == 0 && len(r.Responses) == 0
}

// SumBand maps to assignment_sum_band_results.
type SumBand struct {
	SubscaleCode          string // "OVERALL" is the headline band
	HeadlineScore         string // "46.43%"
	NumericScore          int
	ScaleLabel            string // "13 out of 17"
	SeverityLabel         string
	InterpretationSummary string
}

func (b SumBand) IsOverall() bool { return b.SubscaleCode == "OVERALL" }

// SortBands: OVERALL first, others keep DB order.
func SortBands(bands []SumBand) []SumBand {
	out := append([]SumBand(nil), bands...)
	sort.SliceStable(out, func(i, j int) bool { return out[i].IsOverall() && !out[j].IsOverall() })
	return out
}

type RawScore struct {
	Name       string
	Score      int
	Percentage string
	Gravity    string
}

type rawScoreJSON struct {
	Score      int    `json:"score"`
	Gravity    string `json:"gravity"`
	Percentage string `json:"percentage"` // stored as a string, e.g. "70.00%"
}

func DecodeRawScores(b []byte) ([]RawScore, error) {
	if len(b) == 0 {
		return nil, nil
	}
	var m map[string]rawScoreJSON
	if err := json.Unmarshal(b, &m); err != nil {
		return nil, fmt.Errorf("decode raw_scores: %w", err)
	}
	out := make([]RawScore, 0, len(m))
	for name, v := range m {
		out = append(out, RawScore{
			Name: name, Score: v.Score, Gravity: v.Gravity, Percentage: v.Percentage,
		})
	}
	return out, nil
}

type Response struct {
	Question string
	Answer   string
}

func DecodeResponses(b []byte) ([]Response, error) {
	if len(b) == 0 {
		return nil, nil
	}
	dec := json.NewDecoder(bytes.NewReader(b))
	if t, err := dec.Token(); err != nil || t != json.Delim('{') {
		return nil, fmt.Errorf("decode responses: expected object: %v", err)
	}
	var out []Response
	for dec.More() {
		kt, err := dec.Token()
		if err != nil {
			return nil, fmt.Errorf("decode responses key: %w", err)
		}
		var answer string
		if err := dec.Decode(&answer); err != nil {
			return nil, fmt.Errorf("decode responses %q: %w", kt, err)
		}
		out = append(out, Response{Question: kt.(string), Answer: answer})
	}
	return out, nil
}


templ SumBandGrid(bands []SumBand) {
	if len(bands) > 0 {
		<section aria-label="Scale results" class="flex flex-col gap-3">
			if len(bands) > 1 {
				@SectionHeading("Subscales", -1)
			} else {
				@SectionHeading("Scale", -1)
			}
			<div class="grid sm:grid-cols-2 gap-4">
				for _, b := range SortBands(bands) {
					@SumBandCard(b)
				}
			</div>
		</section>
	}
}

templ SumBandCard(b SumBand) {
	<article
		class={
			"bg-panel border rounded-xl p-4 flex flex-col gap-3",
			templ.KV("border-primary/50 sm:col-span-2", b.IsOverall()),
			templ.KV("border-border", !b.IsOverall()),
		}
	>
		<div class="flex items-start justify-between gap-2">
			<span class="font-mono text-xs font-semibold text-muted tracking-wide">{ b.SubscaleCode }</span>
			@SeverityBadge(b.SeverityLabel)
		</div>
		<div class="flex items-baseline gap-3">
			<span class="text-3xl font-semibold tabular-nums">{ b.HeadlineScore }</span>
			<span class="text-sm text-muted tabular-nums">{ b.ScaleLabel }</span>
		</div>
		@ScoreBar(ParsePercent(b.HeadlineScore), SeverityBarClass(b.SeverityLabel))
		if b.InterpretationSummary != "" {
			<p class="text-sm text-muted leading-relaxed text-pretty">{ b.InterpretationSummary }</p>
		}
	</article>
}

// ScoreBar: 0..100 horizontal fill.
templ ScoreBar(pct float64, barClass string) {
	<div
		class="h-1.5 rounded-full bg-std overflow-hidden"
		role="meter"
		aria-valuemin="0"
		aria-valuemax="100"
		aria-valuenow={ fmt.Sprintf("%.0f", pct) }
	>
		<div class={ "h-full rounded-full", barClass } style={ fmt.Sprintf("width:%.2f%%", pct) }></div>
	</div>
}

templ RawResultsSection(scores []RawScore, responses []Response) {
	if len(scores) > 0 || len(responses) > 0 {
		<section aria-label="Raw results" class="bg-panel border border-border rounded-xl">
			<div class="p-4 border-b border-border">
				@SectionHeading("Raw results", -1)
			</div>
			if len(scores) > 0 {
				@RawScoresTable(scores)
			}
			if len(responses) > 0 {
				<div class="p-4 border-t border-border">
					@ResponseList(responses)
				</div>
			}
		</section>
	}
}


// RawScoreCards is the mobile layout for raw scores.
templ RawScoreCards(scores []RawScore) {
	<ul class="flex flex-col sm:hidden">
		for _, s := range scores {
			<li class="flex flex-col gap-2 px-4 py-3 border-t border-border first:border-t-0">
				<div class="flex items-start justify-between gap-3">
					<span class="min-w-0 text-sm font-medium leading-snug break-words">{ s.Name }</span>
					<span class="shrink-0">
						@SeverityBadge(s.Gravity)
					</span>
				</div>
				<dl class="flex items-baseline gap-4 text-xs text-muted">
					<div class="flex items-baseline gap-1">
						<dt>Score</dt>
						<dd class="text-sm font-semibold tabular-nums text-fg">{ strconv.Itoa(s.Score) }</dd>
					</div>
					<div class="flex items-baseline gap-1">
						<dt class="sr-only">Percentage</dt>
						<dd class="tabular-nums">{ s.Percentage }</dd>
					</div>
				</dl>
				@ScoreBar(ParsePercent(s.Percentage), SeverityBarClass(s.Gravity))
			</li>
		}
	</ul>
}

// RawScoresTable renders stacked cards below sm and a table from sm up.
templ RawScoresTable(scores []RawScore) {
	@RawScoreCards(scores)
	<div class="hidden sm:block">
		<table class="w-full table-fixed text-sm">
			<colgroup>
				<col/>
				<col class="w-20"/>
				<col class="w-28"/>
				<col class="w-40"/>
			</colgroup>
			<thead>
				<tr class="text-left text-xs text-muted">
					<th scope="col" class="px-4 py-2 font-medium">Scale</th>
					<th scope="col" class="px-4 py-2 font-medium text-right">Score</th>
					<th scope="col" class="px-4 py-2 font-medium text-right">Percentage</th>
					<th scope="col" class="px-4 py-2 font-medium">Gravity</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range scores {
					<tr class="border-t border-border">
						<td class="px-4 py-2.5 break-words">{ s.Name }</td>
						<td class="px-4 py-2.5 text-right tabular-nums font-medium">{ strconv.Itoa(s.Score) }</td>
						<td class="px-4 py-2.5 text-right tabular-nums">{ s.Percentage }</td>
						<td class="px-4 py-2.5">
							@SeverityBadge(s.Gravity)
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ ResponseList(responses []Response) {
	<h4 class="text-xs font-semibold text-muted uppercase tracking-wide mb-3">
		{ fmt.Sprintf("Responses (%d)", len(responses)) }
	</h4>
	<ol class="flex flex-col">
		for i, r := range responses {
			<li class="flex items-start gap-3 py-3 border-t border-border first:border-t-0">
				<span class="w-6 shrink-0 text-xs text-muted tabular-nums leading-relaxed text-right">{ strconv.Itoa(i + 1) }</span>
				<div class="flex-1 min-w-0 flex flex-col gap-2 sm:flex-row sm:items-start sm:gap-4">
					<p class="flex-1 min-w-0 text-sm leading-relaxed break-words text-pretty">{ r.Question }</p>
					<p class="min-w-0 sm:w-44 sm:shrink-0 sm:text-right">
						<span class="sr-only">Answer: </span>
						<span class="inline-block max-w-full text-xs font-medium px-2 py-1 rounded-md bg-std border border-border break-words">{ r.Answer }</span>
					</p>
				</div>
			</li>
		}
	</ol>
}
