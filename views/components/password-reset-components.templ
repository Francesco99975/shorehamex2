package components

import "github.com/Francesco99975/shorehamex2/views/ui"
import "github.com/Francesco99975/shorehamex2/views/icons"

templ RequestResetCard(csrf string) {
	<div id="card" class="bg-std rounded-2xl shadow-xl border border-accent/50 p-8">
		<!-- Header -->
		<div class="text-center mb-8">
			<div class="inline-flex items-center justify-center w-16 h-16 bg-primary/10 rounded-full mb-4">
				@icons.Lock("w-8 h-8 text-primary")
			</div>
			<h1 class="text-2xl font-bold text-primary mb-2">Reset Password</h1>
			<p class="text-accent">Enter your email address and we'll send you a reset code</p>
		</div>
		<!-- Request Form -->
		<form
			hx-post="/reset/check"
			hx-target="#card"
			hx-swap="outerHTML"
			{ ui.WithLoading("rrc-indicator")... }
			class="space-y-6"
		>
			@CSRF(csrf)
			@ui.Input(ui.InputProps{
				Name:     "email",
				Type:     "email",
				Label:    "Email Address",
				Required: true,
			})
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonLG,
				FullW:   true,
				Type:    ui.TypeSubmit,
			}) {
				<span>Send Reset token</span>
			}
			@ui.FormLoading("rrc-indicator", "Sending email with token...")
		</form>
		<!-- Back to Login -->
		<div class="mt-6 text-center">
			<a href="/" hx-boost="true" hx-push-url="true" hx-target="body" class="inline-flex items-center text-sm text-primary hover:text-primary transition-colors">
				@icons.ArrowLeft("w-4 h-4 mr-1")
				Back to Login
			</a>
		</div>
	</div>
}

templ DevResetCard(csrf string, userID string) {
	<div id="card" class="bg-std rounded-2xl shadow-xl border border-accent/50 p-8">
		<!-- Header -->
		<div class="text-center mb-8">
			<div class="inline-flex items-center justify-center w-16 h-16 bg-info/10 rounded-full mb-4">
				@icons.Mail("w-8 h-8 text-info")
			</div>
			<h1 class="text-2xl font-bold text-primary/75 mb-2">Enter your new <span data-text="DEV" class="neon-primary glitch flicker">DEV</span> credentials</h1>
		</div>
		<form
			hx-post="/reset/dev"
			hx-target="#card"
			hx-swap="outerHTML"
			{ ui.WithLoading("reset-indicator")... }
			class="space-y-6"
		>
			@CSRF(csrf)
			@ui.HiddenInput("token", userID)
			@ui.SecurePasswordInput(ui.PasswordProps{
				Name:         "new-password",
				Label:        "New Password",
				Required:     true,
				ShowStrength: true,
				MinLen:       8})
			@ui.SecurePasswordInput(ui.PasswordProps{
				Name:         "confirm-password",
				Label:        "Confirm Password",
				Required:     true,
				ShowStrength: true,
				MinLen:       8,
			})
			@ui.Button(ui.ButtonProps{
				Variant: ui.ButtonPrimary,
				Size:    ui.ButtonLG,
				FullW:   true,
				Type:    ui.TypeSubmit,
			}) {
				<span>Reset Password</span>
			}
			@ui.FormLoading("reset-indicator", "Resetting Password...")
		</form>
		<!-- Back to Login -->
		<div class="mt-4 text-center">
			<a href="/" class="inline-flex items-center text-sm text-primary hover:text-primary transition-colors">
				@icons.ArrowLeft("w-4 h-4 mr-1")
				Back to Login
			</a>
		</div>
	</div>
}

