package results

import (
	"fmt"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/enums"
	"github.com/Francesco99975/shorehamex2/views/icons"
	"github.com/Francesco99975/shorehamex2/views/ui"
	"github.com/Francesco99975/shorehamex2/internal/repository"
)

// ExaminationMetaProps maps to the `examinations` row.
type ExaminationMetaProps struct {
	Mode        enums.AssignmentMode
	Status      repository.ExaminationStatus
	Overdue     bool // see IsOverdue()
	AssignedAt  time.Time // created_at
	DueAt       *time.Time
	StartedAt   *time.Time
	CompletedAt *time.Time
	ReviewedAt  *time.Time
	Steps       []ProgressStep // see StepsFromRows()
}

// ProgressStep is one chip on the progress track.
type ProgressStep struct {
	Sequence int
	TestCode string
	Done     bool
}

func DoneCount(steps []ProgressStep) int {
	n := 0
	for _, s := range steps {
		if s.Done {
			n++
		}
	}
	return n
}

templ ExaminationMetaCard(p ExaminationMetaProps) {
	@Panel("Examination", true) {
		<div class="flex items-center gap-2 flex-wrap">
			<h3 class="text-sm font-semibold mr-1">Examination</h3>
			@ModeBadge(p.Mode)
			@ExaminationStatusBadge(p.Status)
			if p.Overdue {
				@OverdueBadge()
			}
		</div>
		<dl class="grid grid-cols-2 md:grid-cols-4 gap-4">
			@MetaField("Assigned", FormatDate(p.AssignedAt), false)
			@MetaField("Due", FormatDateTime(p.DueAt), p.Overdue)
			@MetaField("Started", FormatDateTime(p.StartedAt), false)
			@MetaField("Completed", FormatDateTime(p.CompletedAt), false)
			if p.ReviewedAt != nil {
				@MetaField("Reviewed", FormatDateTime(p.ReviewedAt), false)
			}
		</dl>
		@ProgressTrack(p.Steps)
	}
}

templ ProgressTrack(steps []ProgressStep) {
	<div class="flex flex-col gap-1.5">
		<div class="flex items-center justify-between text-xs text-muted">
			<span class="font-medium text-fg">Progress</span>
			<span>{ fmt.Sprintf("%d / %d completed", DoneCount(steps), len(steps)) }</span>
		</div>
		<ol class="flex flex-wrap gap-1.5">
			for _, s := range steps {
				<li
					class={
						"inline-flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-md border",
						templ.KV("bg-primary text-primary-fg border-primary", s.Done),
						templ.KV("bg-std text-muted border-border", !s.Done),
					}
				>
					if s.Done {
						@icons.CheckIcon("w-3 h-3")
						<span class="sr-only">Completed:</span>
					}
					<span>{ s.TestCode }</span>
				</li>
			}
		</ol>
	</div>
}

// CopyLinkButton copies the remote examination link; self-contained Alpine scope.
templ CopyLinkButton(link string) {
	<div x-data="{ copied: false }" class="contents">
		@ui.Button(ui.ButtonProps{
			Variant: ui.ButtonGhost,
			Size:    ui.ButtonMD,
			Type:    ui.TypeButton,
			Attrs: templ.Attributes{
				"@click":      fmt.Sprintf("navigator.clipboard.writeText(%q); copied = true; setTimeout(() => copied = false, 1600)", link),
				":class":      "copied ? 'border-success text-success bg-success/10' : ''",
				":aria-label": "copied ? 'Link copied' : 'Copy remote link'",
			},
		}) {
			<span x-show="!copied" class="flex items-center gap-1.5">
				@icons.Copy("w-4 h-4")
				<span>Copy link</span>
			</span>
			<span x-show="copied" x-cloak class="flex items-center gap-1.5">
				@icons.CheckIcon("w-4 h-4")
				<span>Link copied</span>
			</span>
		}
	</div>
}
