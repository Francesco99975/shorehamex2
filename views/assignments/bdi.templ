package assignments

import (
	"strconv"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
)

templ Bdi(site config.Site, groups [][]string, path string) {
	@TestShell(site, TestShellProps{
		Eyebrow:       "Assessment",
		Title:         "Beck Depression Inventory",
		Subtitle:      "Please complete all questions.",
		QuestionCount: len(groups),
	}) {
		@Instructions("This questionnaire consists of 21 groups of statements. Please read each group carefully, then pick the one statement in each group that best describes the way you have been feeling during the past two weeks, including today.")
		<div id="tab-content" class="flex flex-col">
		<form
			data-test-form
			class="flex flex-col gap-4"
			hx-post={ path }
			hx-target="body"
			hx-replace-url="true"
			hx-indicator="#indicator"
		>
			@components.CSRF(site.CSRF)
			<input type="hidden" name="start" id="start" value={ time.Now().Unix() }/>
			@TestProgress(TestProgressProps{Total: len(groups)})
			for index, group := range groups {
				@QuestionCard(QuestionCardProps{Number: index + 1, Prompt: "Choose the statement that fits you best"}) {
					@StatementChoices(StatementChoicesProps{Name: strconv.Itoa(index), Options: OptionsFromLabels(group, 0), Required: true})
				}
			}
			@SubmitSection("Check that every group has a statement selected before you submit.") {
				@SubmitCheckIcon()
				<span>Submit questionnaire</span>
			}
		</form>
		</div>
	}
}
