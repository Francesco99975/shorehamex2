package views

import (
	"github.com/Francesco99975/shorehamex2/internal/config"
	"github.com/Francesco99975/shorehamex2/views/components"
	"github.com/Francesco99975/shorehamex2/views/layouts"
	"github.com/Francesco99975/shorehamex2/views/ui"
)

templ Index(site config.Site) {
	@layouts.Base(site) {
		<main class="min-h-screen grid lg:grid-cols-2">
			<!-- Brand side -->
			<section class="hidden lg:flex flex-col justify-between p-12 bg-primary text-primary-fg">
				<div class="flex items-center gap-3">
					@ui.HeaderBrandFg(site.AppName, site.Title, "/")
				</div>
				<div class="max-w-md">
					<h1 class="text-4xl font-semibold leading-tight text-balance">Clinical assessment console for your practice.</h1>
					<p class="mt-4 text-primary-fg/80 leading-relaxed">
						Assign, administer and track standardized instruments — ASQ, BDI, BAI, P3 and MMPI-2 —
						in-clinic or remotely, with everything in one secure place.
					</p>
				</div>
				<p class="text-sm text-primary-fg/70">Clinical Testing tools</p>
			</section>
			<!-- Form side -->
			<section class="flex items-center justify-center p-6 sm:p-12">
				<div class="w-full max-w-sm">
					<div class="flex items-center justify-between mb-8">
						<div class="flex items-center gap-2 lg:hidden">
							@ui.HeaderBrand(site.AppName, site.Title, "/")
						</div>
						@ui.ThemeToggle()
					</div>
					<h2 class="text-2xl font-semibold">Staff sign in</h2>
					<p class="text-muted mt-1 text-sm">Welcome back. Please enter your credentials.</p>
					<form
						hx-post="/login"
						hx-target="this"
						hx-swap="outerHTML"
						{ ui.WithLoading("login-indicator")... }
						class="mt-8 space-y-4"
					>
						@components.CSRF(site.CSRF)
						@ui.Input(ui.InputProps{
							Name:     "eou",
							Label:    "Email or Username",
							Required: true,
						})
						@ui.SecurePasswordInput(ui.PasswordProps{
							Name:     "password",
							Label:    "Password",
							Required: true,
						})
						<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
							@ui.Checkbox(ui.CheckboxProps{Name: "remember", Label: "Remember me"})
							@ui.BasicForgotPassword()
						</div>
						@ui.Button(ui.ButtonProps{
							Variant: ui.ButtonPrimary,
							FullW:   true,
							Type:    "submit",
							Loading: ui.LoadingConfig{
								IndicatorID: "login-indicator",
							},
							Size: ui.ButtonLG,
						}) {
							<span>Sign In</span>
						}
					</form>
					<p class="mt-6 text-xs text-muted text-center">Protected area · access is logged for compliance.</p>
				</div>
			</section>
		</main>
	}
}
