package results

import (
	"fmt"
	"time"

	"github.com/Francesco99975/shorehamex2/internal/enums"
	"github.com/Francesco99975/shorehamex2/views/icons"
)

// PatientIdentityProps maps 1:1 to the `patients` row fields the results views need.
type PatientIdentityProps struct {
	ID          string
	MRN         string
	FullName    string
	Email       string
	Phone       string
	DateOfBirth time.Time
	Sex         enums.Sex
	Now         time.Time // reference date for Age(); zero => time.Now()
}

func (p PatientIdentityProps) Age() int {
	now := p.Now
	if now.IsZero() {
		now = time.Now()
	}
	return AgeAt(p.DateOfBirth, now)
}

// AgeSexLine: "32 years · Male".
func (p PatientIdentityProps) AgeSexLine() string {
	return fmt.Sprintf("%d years · %s", p.Age(), Humanize(p.Sex.String()))
}

// PatientIdentityCard: MRN, name, age/sex, mailto/tel links.
// children => right-aligned action slot (copy link, delete, ...).
templ PatientIdentityCard(p PatientIdentityProps) {
	<section aria-label="Patient" class="bg-panel border border-border rounded-xl p-5 flex flex-col gap-5">
		<div class="flex items-start justify-between gap-4 flex-wrap">
			<div class="flex items-center gap-4 min-w-0">
				@Avatar(p.FullName, AvatarLG)
				<div class="min-w-0 flex flex-col gap-1">
					<span class="self-start font-mono text-xs font-semibold px-2 py-0.5 rounded bg-std border border-border tracking-wide">
						{ p.MRN }
					</span>
					<h2 class="text-2xl font-semibold truncate">{ p.FullName }</h2>
					<p class="text-sm text-muted">{ p.AgeSexLine() }</p>
				</div>
			</div>
			<div class="flex items-center gap-2">
				{ children... }
			</div>
		</div>
		@ContactLinks(p.Email, p.Phone)
	</section>
}

// PatientSummary: compact avatar + name + age/sex (assignment headers).
templ PatientSummary(p PatientIdentityProps) {
	<div class="flex items-center gap-4 min-w-0">
		@Avatar(p.FullName, AvatarMD)
		<div class="min-w-0 flex flex-col gap-1">
			<h2 class="text-xl font-semibold truncate">{ p.FullName }</h2>
			<p class="text-sm text-muted">{ p.AgeSexLine() }</p>
		</div>
	</div>
}

templ ContactLinks(email, phone string) {
	if email != "" || phone != "" {
		<div class="flex flex-wrap gap-2">
			if email != "" {
				@ContactLink(ContactLinkProps{Label: "Email", Value: email, Href: templ.SafeURL("mailto:" + email), Icon: icons.Mail("w-4 h-4")})
			}
			if phone != "" {
				@ContactLink(ContactLinkProps{Label: "Phone", Value: phone, Href: templ.SafeURL(TelHref(phone)), Icon: icons.Phone("w-4 h-4")})
			}
		</div>
	}
}

type ContactLinkProps struct {
	Label string
	Value string
	Href  templ.SafeURL
	Icon  templ.Component
}

templ ContactLink(p ContactLinkProps) {
	<a
		href={ p.Href }
		class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-border text-sm hover:bg-std hover:border-primary/50 transition"
	>
		if p.Icon != nil {
			<span class="text-muted" aria-hidden="true">
				@p.Icon
			</span>
		}
		<span class="text-muted text-xs font-medium uppercase tracking-wide">{ p.Label }</span>
		<span class="font-medium text-primary underline-offset-2 hover:underline">{ p.Value }</span>
	</a>
}
